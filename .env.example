# Which model answers questions: gemini | anthropic | openai | none (none = no-key mode)
LLM_PROVIDER=gemini

# Gemini (free tier keys: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is busy (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest

# Optional alternatives
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local embeddings for hybrid search (1 = on). Downloads a ~70 MB model on first use.
USE_EMBEDDINGS=1

# Public-demo guards
MAX_UPLOAD_MB=15
MAX_PAGES=40
RATE_LIMIT_PER_HOUR=0
# Model calls per UTC day across all visitors; past it, answers fall back to search-only. 0 = no cap
DAILY_LLM_LIMIT=0
# Delete uploaded PDFs after this many hours. 0 = keep
UPLOAD_TTL_HOURS=0
# OCR for uploaded scans (peaks near 1 GB of memory). 0 = skip scanned pages of uploads
OCR_UPLOADS=1
